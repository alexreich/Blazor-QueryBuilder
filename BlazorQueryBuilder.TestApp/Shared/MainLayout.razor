@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-bar">
            <div class="container-fluid">
                <h1 class="h4 mb-0 text-primary">Blazor QueryBuilder Test Application</h1>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<style>
    .page {
        position: relative;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    .sidebar {
        background-image: linear-gradient(180deg, rgb(5, 39, 103) 0%, #3a0647 70%);
        width: 260px;
        height: 100vh;
        position: fixed;
        top: 0;
        left: 0;
        z-index: 1000;
    }

    .top-bar {
        background: white;
        border-bottom: 1px solid #dee2e6;
        padding: 1rem 0;
        margin-left: 260px;
    }

    main {
        flex: 1;
    }

    .content {
        margin-left: 260px;
        padding-top: 1rem;
    }

    @@media (max-width: 767.98px) {
        .sidebar {
            transform: translateX(-100%);
            transition: transform 0.3s ease-in-out;
        }
        
        .content, .top-bar {
            margin-left: 0;
        }
    }
</style>