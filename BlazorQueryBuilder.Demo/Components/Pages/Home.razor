@page "/"

<PageTitle>BlazorQueryBuilder Demo</PageTitle>

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <h1 class="display-4">🔍 BlazorQueryBuilder Demo</h1>
            <p class="lead">Interactive demonstration of the BlazorQueryBuilder component in action.</p>
            
            <div class="alert alert-info">
                <h5><i class="bi bi-info-circle"></i> Welcome to the Demo</h5>
                <p class="mb-0">
                    This demo application showcases how to consume BlazorQueryBuilder as a NuGet package.
                    Explore the different demo pages to see the component in action with various configurations.
                </p>
            </div>

            <div class="row mt-4">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">
                                <i class="bi bi-play-circle text-primary"></i> Basic Demo
                            </h5>
                            <p class="card-text">
                                Get started with simple query building using common filter types.
                            </p>
                            <a href="/basic-demo" class="btn btn-primary">Try Basic Demo</a>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">
                                <i class="bi bi-gear text-success"></i> Advanced Demo
                            </h5>
                            <p class="card-text">
                                Explore advanced features, custom filters, and API methods.
                            </p>
                            <a href="/advanced-demo" class="btn btn-success">Try Advanced Demo</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-5">
                <h3>🚀 Quick Start</h3>
                <p>To use BlazorQueryBuilder in your own project:</p>
                
                <div class="row">
                    <div class="col-md-6">
                        <h5>1. Install the Package</h5>
                        <pre class="bg-light p-3 rounded">
<code>dotnet add package BlazorQueryBuilder</code></pre>
                    </div>
                    
                    <div class="col-md-6">
                        <h5>2. Add to Program.cs</h5>
                        <pre class="bg-light p-3 rounded">
<code>builder.Services.AddBlazorQueryBuilder();</code></pre>
                    </div>
                </div>
                
                <div class="mt-3">
                    <h5>3. Use in Components</h5>
                    <pre class="bg-light p-3 rounded">
<code>@@using BlazorQueryBuilder.Components
@@using BlazorQueryBuilder.Models

&lt;QueryBuilder @@ref="queryBuilder"
              Filters="filters"
              OnRulesChanged="OnRulesChanged" /&gt;</code></pre>
                </div>
            </div>
        </div>
    </div>
</div>