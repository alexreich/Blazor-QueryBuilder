@page "/advanced-demo"
@using BlazorQueryBuilder.Components
@using BlazorQueryBuilder.Models

<PageTitle>Advanced Demo - BlazorQueryBuilder</PageTitle>

<div class="container mt-4">
    <h1>⚙️ Advanced Demo</h1>
    <p class="lead">Advanced features, custom configurations, and API testing.</p>

    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Advanced Query Builder</h5>
                </div>
                <div class="card-body">
                    <QueryBuilder @ref="queryBuilder"
                                  Filters="advancedFilters"
                                  Options="builderOptions"
                                  OnRulesChanged="OnRulesChanged" />
                </div>
            </div>

            <div class="mt-3">
                <h5>API Methods Testing</h5>
                <div class="btn-group me-2" role="group">
                    <button class="btn btn-outline-primary" @onclick="GetRules">Get Rules</button>
                    <button class="btn btn-outline-secondary" @onclick="ClearRules">Clear</button>
                    <button class="btn btn-outline-info" @onclick="ValidateRules">Validate</button>
                </div>
                
                <div class="btn-group me-2" role="group">
                    <button class="btn btn-outline-success" @onclick="LoadComplexRules">Complex Rules</button>
                    <button class="btn btn-outline-warning" @onclick="LoadNestedRules">Nested Rules</button>
                </div>
                
                <button class="btn btn-outline-danger" @onclick="StressTest">Stress Test</button>
            </div>

            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <div class="alert @(statusMessage.Contains("Error") ? "alert-danger" : "alert-success") mt-3">
                    <i class="bi @(statusMessage.Contains("Error") ? "bi-exclamation-triangle" : "bi-check-circle")"></i>
                    @statusMessage
                </div>
            }

            @if (performanceResults.Any())
            {
                <div class="mt-3">
                    <h6>Performance Results</h6>
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Operation</th>
                                    <th>Time (ms)</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var result in performanceResults.TakeLast(5))
                                {
                                    <tr>
                                        <td>@result.Operation</td>
                                        <td>@result.TimeMs</td>
                                        <td>
                                            <span class="badge @(result.Success ? "bg-success" : "bg-danger")">
                                                @(result.Success ? "Success" : "Failed")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0">Live Rules Output</h6>
                </div>
                <div class="card-body">
                    <pre class="bg-light p-2 rounded small" style="max-height: 600px; overflow-y: auto;">@rulesJson</pre>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private QueryBuilder queryBuilder = default!;
    private string rulesJson = "{}";
    private string statusMessage = "";
    private List<PerformanceResult> performanceResults = new();

    private readonly QueryBuilderFilter[] advancedFilters = new[]
    {
        new QueryBuilderFilter 
        { 
            Id = "firstName", 
            Label = "First Name", 
            Type = "string",
            Operators = new[] { "equal", "not_equal", "contains", "not_contains", "begins_with", "ends_with" }
        },
        new QueryBuilderFilter 
        { 
            Id = "lastName", 
            Label = "Last Name", 
            Type = "string" 
        },
        new QueryBuilderFilter 
        { 
            Id = "department", 
            Label = "Department", 
            Type = "string",
            Input = "select",
            Values = new Dictionary<string, string>
            {
                { "IT", "Information Technology" },
                { "HR", "Human Resources" },
                { "SALES", "Sales" },
                { "MARKETING", "Marketing" },
                { "FINANCE", "Finance" }
            }
        },
        new QueryBuilderFilter 
        { 
            Id = "salary", 
            Label = "Annual Salary", 
            Type = "double",
            Validation = new QueryBuilderValidation { Min = 0, Max = 1000000, Step = 1000 }
        },
        new QueryBuilderFilter 
        { 
            Id = "experience", 
            Label = "Years of Experience", 
            Type = "integer",
            Validation = new QueryBuilderValidation { Min = 0, Max = 50 }
        },
        new QueryBuilderFilter 
        { 
            Id = "isManager", 
            Label = "Is Manager", 
            Type = "boolean" 
        },
        new QueryBuilderFilter 
        { 
            Id = "hireDate", 
            Label = "Hire Date", 
            Type = "date" 
        },
        new QueryBuilderFilter 
        { 
            Id = "lastReviewDate", 
            Label = "Last Review Date", 
            Type = "datetime" 
        },
        new QueryBuilderFilter 
        { 
            Id = "rating", 
            Label = "Performance Rating", 
            Type = "double",
            Input = "select",
            Values = new Dictionary<string, string>
            {
                { "1.0", "Poor (1.0)" },
                { "2.0", "Below Average (2.0)" },
                { "3.0", "Average (3.0)" },
                { "4.0", "Above Average (4.0)" },
                { "5.0", "Excellent (5.0)" }
            }
        }
    };

    private readonly object builderOptions = new
    {
        allow_empty = true,
        allow_groups = true,
        default_condition = "AND",
        sort_filters = true
    };

    private async Task OnRulesChanged(string rules)
    {
        rulesJson = rules;
        await InvokeAsync(StateHasChanged);
    }

    private async Task<TimeSpan> MeasureAsync(Func<Task> operation)
    {
        var stopwatch = System.Diagnostics.Stopwatch.StartNew();
        await operation();
        stopwatch.Stop();
        return stopwatch.Elapsed;
    }

    private async Task GetRules()
    {
        try
        {
            var elapsed = await MeasureAsync(async () =>
            {
                var rules = await queryBuilder.GetRulesAsync();
                rulesJson = rules;
            });
            
            statusMessage = $"Rules retrieved in {elapsed.TotalMilliseconds:F1}ms";
            performanceResults.Add(new PerformanceResult("GetRules", (int)elapsed.TotalMilliseconds, true));
        }
        catch (Exception ex)
        {
            statusMessage = $"Error getting rules: {ex.Message}";
            performanceResults.Add(new PerformanceResult("GetRules", 0, false));
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task ClearRules()
    {
        try
        {
            var elapsed = await MeasureAsync(() => queryBuilder.ClearAsync());
            statusMessage = $"Rules cleared in {elapsed.TotalMilliseconds:F1}ms";
            performanceResults.Add(new PerformanceResult("Clear", (int)elapsed.TotalMilliseconds, true));
        }
        catch (Exception ex)
        {
            statusMessage = $"Error clearing rules: {ex.Message}";
            performanceResults.Add(new PerformanceResult("Clear", 0, false));
        }
    }

    private async Task ValidateRules()
    {
        try
        {
            bool isValid = false;
            var elapsed = await MeasureAsync(async () =>
            {
                isValid = await queryBuilder.ValidateAsync();
            });
            statusMessage = $"Validation result: {(isValid ? "Valid" : "Invalid")} (took {elapsed.TotalMilliseconds:F1}ms)";
            performanceResults.Add(new PerformanceResult("Validate", (int)elapsed.TotalMilliseconds, true));
        }
        catch (Exception ex)
        {
            statusMessage = $"Error validating rules: {ex.Message}";
            performanceResults.Add(new PerformanceResult("Validate", 0, false));
        }
    }

    private async Task LoadComplexRules()
    {
        try
        {
            var complexRules = @"{
                ""condition"": ""AND"",
                ""rules"": [
                    {
                        ""id"": ""department"",
                        ""operator"": ""in"",
                        ""value"": [""IT"", ""SALES""]
                    },
                    {
                        ""condition"": ""OR"",
                        ""rules"": [
                            {
                                ""id"": ""salary"",
                                ""operator"": ""greater"",
                                ""value"": 75000
                            },
                            {
                                ""id"": ""experience"",
                                ""operator"": ""greater_or_equal"",
                                ""value"": 5
                            }
                        ]
                    },
                    {
                        ""id"": ""isManager"",
                        ""operator"": ""equal"",
                        ""value"": true
                    }
                ]
            }";
            
            var elapsed = await MeasureAsync(() => queryBuilder.SetRulesAsync(complexRules));
            statusMessage = $"Complex rules loaded in {elapsed.TotalMilliseconds:F1}ms";
            performanceResults.Add(new PerformanceResult("LoadComplex", (int)elapsed.TotalMilliseconds, true));
        }
        catch (Exception ex)
        {
            statusMessage = $"Error loading complex rules: {ex.Message}";
            performanceResults.Add(new PerformanceResult("LoadComplex", 0, false));
        }
    }

    private async Task LoadNestedRules()
    {
        try
        {
            var nestedRules = @"{
                ""condition"": ""AND"",
                ""rules"": [
                    {
                        ""condition"": ""OR"",
                        ""rules"": [
                            {
                                ""id"": ""firstName"",
                                ""operator"": ""begins_with"",
                                ""value"": ""John""
                            },
                            {
                                ""id"": ""lastName"",
                                ""operator"": ""contains"",
                                ""value"": ""Smith""
                            }
                        ]
                    },
                    {
                        ""condition"": ""AND"",
                        ""rules"": [
                            {
                                ""id"": ""hireDate"",
                                ""operator"": ""greater"",
                                ""value"": ""2020-01-01""
                            },
                            {
                                ""condition"": ""OR"",
                                ""rules"": [
                                    {
                                        ""id"": ""rating"",
                                        ""operator"": ""greater_or_equal"",
                                        ""value"": 4.0
                                    },
                                    {
                                        ""id"": ""salary"",
                                        ""operator"": ""greater"",
                                        ""value"": 100000
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }";
            
            var elapsed = await MeasureAsync(() => queryBuilder.SetRulesAsync(nestedRules));
            statusMessage = $"Nested rules loaded in {elapsed.TotalMilliseconds:F1}ms";
            performanceResults.Add(new PerformanceResult("LoadNested", (int)elapsed.TotalMilliseconds, true));
        }
        catch (Exception ex)
        {
            statusMessage = $"Error loading nested rules: {ex.Message}";
            performanceResults.Add(new PerformanceResult("LoadNested", 0, false));
        }
    }

    private async Task StressTest()
    {
        statusMessage = "Running stress test...";
        await InvokeAsync(StateHasChanged);
        
        try
        {
            var totalElapsed = await MeasureAsync(async () =>
            {
                // Rapid operations test
                for (int i = 0; i < 10; i++)
                {
                    await queryBuilder.GetRulesAsync();
                    await Task.Delay(10);
                }
            });
            
            statusMessage = $"Stress test completed: 10 operations in {totalElapsed.TotalMilliseconds:F1}ms (avg: {totalElapsed.TotalMilliseconds/10:F1}ms/op)";
            performanceResults.Add(new PerformanceResult("StressTest", (int)totalElapsed.TotalMilliseconds, true));
        }
        catch (Exception ex)
        {
            statusMessage = $"Stress test failed: {ex.Message}";
            performanceResults.Add(new PerformanceResult("StressTest", 0, false));
        }
    }

    private record PerformanceResult(string Operation, int TimeMs, bool Success);
}